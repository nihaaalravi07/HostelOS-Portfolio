# Copy to .env and fill in. NEVER commit the real .env file.
# Used by `docker compose --profile full` (see docker-compose.yml) and as a reference for every other run mode.

# REQUIRED. Secret used to sign login tokens (HS256). At least 32 characters.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-string

# Optional: seed demo data and show the demo accounts on the login screen.
# Local demos only. Leave false (the application default) for any real deployment.
DEMO_MODE=true

# Optional: password of the seeded demo accounts (used only when DEMO_MODE=true).
# DEMO_PASSWORD=hostelos123

# Database. Pick ONE style.
# 1) One connection string (used on hosting platforms, translated to JDBC automatically):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
# 2) Separate values (defaults match `docker compose up -d`):
# DB_URL=jdbc:postgresql://localhost:5432/hostelos
# DB_USER=hostelos
# DB_PASSWORD=hostelos

# Optional: when set, the whole site asks visitors for this passcode first (useful for a public demo deployment).
# SITE_PASSCODE=choose-a-passcode

# Optional: port (hosting platforms inject this) and connection pool size.
# PORT=8080
# DB_POOL_SIZE=5
